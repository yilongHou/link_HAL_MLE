{
    "sampler_setup": {
        "sampler": "TruncatedNormal",
        "sampler_params": {
            "mean": 0.5,
            "std": 0.1,
            "lower": 0,
            "upper": 1
        },
        "n_samples": 3200
    },
    "estimator_setup": {
        "estimator": "ProximalNewtonLBFGSEstimator",
        "estimator_params": {
            "lam": 0.25,
            "n_iterations": 200001,
            "tol": 1e-08,
            "basis_order": 2,
            "log_frequency": 10,
            "n_grid_points": 200,
            "lbfgs_gamma_clip_range": [
                1e-3,
                1e3
            ]
        }
    }
}